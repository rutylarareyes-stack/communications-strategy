---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';

const pageTitle = 'Journalism, International Cooperation & Research | Ruth Lara Reyes, PhD';
const pageDescription =
	'Freelance journalist, editorial writer, and researcher with a PhD in International Cooperation based in Florence, Italy. Available for international reporting, published stories, policy briefs, and qualitative research in English, Italian, and Spanish.';

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Ruth Lara Reyes',
	honorificSuffix: 'PhD',
	jobTitle: 'Freelance Journalist & International Cooperation Researcher',
	description: pageDescription,
	sameAs: ['https://muckrack.com'],
	knowsLanguage: ['English', 'Italian', 'Spanish'],
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Florence',
		addressCountry: 'IT',
	},
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<div class="stack gap-20">
		<div class="wrapper stack gap-8">
			<Hero
				title="Journalism & International Cooperation Research"
				tagline="Cross-border stories, qualitative research, and policy analysis in English, Italian, and Spanish — grounded in a PhD in International Cooperation and international journalism experience."
				align="start"
			>
				<div class="roles">
					<Pill><Icon icon="pencil-line" size="1.33em" /> Freelance Journalism & Stories</Pill>
					<Pill><Icon icon="strategy" size="1.33em" /> International Cooperation Research</Pill>
					<Pill><Icon icon="microphone-stage" size="1.33em" /> Policy Briefs & Field Reporting</Pill>
				</div>
				<div class="muckrack-bar">
					<a
						href="https://muckrack.com"
						target="_blank"
						rel="noopener noreferrer"
						class="muckrack-link"
					>
						Read My Published Stories & Reporting on Muck Rack →
					</a>
				</div>
			</Hero>
		</div>

		<main class="wrapper stack gap-15">
			<section class="section-grid">
				<h2 class="section-title">Editorial & Research Services</h2>
				<div class="content stack gap-6">
					<div class="service-card">
						<h3>1. International Cooperation, Migration & Development Research</h3>
						<p>
							Qualitative research design, stakeholder interviews, literature reviews, and field
							assessments backed by a <strong>PhD in International Cooperation</strong>. Available for
							NGOs, international organizations, European project consortia, universities, and
							foundations.
						</p>
					</div>

					<div class="service-card">
						<h3>2. Freelance Journalism & Cross-Border Stories</h3>
						<p>
							In-depth articles, interviews, and human-interest reporting written natively in
							<strong>Spanish</strong> and fluently in <strong>English</strong> and
							<strong>Italian</strong>. Covering international cooperation, migration, diaspora
							communities, education, and European–Latin American perspectives from Italy.
						</p>
					</div>

					<div class="service-card">
						<h3>3. Policy Briefs, Project Reports & Institutional Publications</h3>
						<p>
							Translating complex research findings, cooperation programs, and multi-stakeholder
							initiatives into clear, publication-ready policy briefs, white papers, and executive
							reports for public bodies, cultural institutions, and non-profits.
						</p>
					</div>

					<div class="service-card">
						<h3>4. Field Fixing, Bilingual Interviewing & Fact-Checking in Italy</h3>
						<p>
							On-the-ground research and editorial support in Florence and across Italy for
							international newsrooms, documentary teams, and academic researchers—including source
							identification, trilingual interviewing, and contextual verification.
						</p>
					</div>
				</div>
			</section>

			<section class="section-grid">
				<h2 class="section-title">Academic & Editorial Credentials</h2>
				<div class="content stack gap-4">
					<p>
						My work bridges <strong>academic research in international cooperation</strong>,
						<strong>journalistic storytelling</strong>, and <strong>university lecturing in Ecuador</strong>—enabling
						organizations and media outlets to produce rigorous, accessible, and culturally grounded
						content across languages.
					</p>
					<ul class="highlights">
						<li><strong>PhD in International Cooperation</strong> — specialized in cross-border social dynamics, development, and institutional communication.</li>
						<li><strong>Verified Journalist on Muck Rack</strong> — <a href="https://muckrack.com" target="_blank" rel="noopener noreferrer">://muckrack.com</a>.</li>
						<li><strong>Former University Lecturer</strong> — teaching communication, media analysis, and research methodology.</li>
						<li><strong>Trilingual Execution</strong> — full research, interviewing, and publication in <strong>English, Italian, and Spanish</strong> from Florence, Italy.</li>
					</ul>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}

	.muckrack-bar {
		margin-top: 0.75rem;
	}

	.muckrack-link {
		display: inline-block;
		font-weight: 600;
		color: var(--accent-regular);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.section-grid {
		display: grid;
		gap: 1.5rem;
	}

	.section-title {
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		color: var(--gray-200);
		font-size: var(--text-md);
		line-height: 1.65;
	}

	.service-card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.service-card h3 {
		font-size: var(--text-lg);
		color: var(--gray-0);
		margin-bottom: 0.5rem;
	}

	.highlights {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding-left: 1.25rem;
	}

	.highlights a {
		color: var(--accent-regular);
		text-decoration: underline;
	}

	@media (min-width: 50em) {
		.section-grid {
			grid-template-columns: 1fr 2fr;
			gap: 3rem;
		}

		.section-title {
			font-size: var(--text-2xl);
		}
	}
</style>

