---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CallToAction from '../../components/CallToAction.astro';
import Grid from '../../components/Grid.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Skills from '../../components/Skills.astro';

const projects = (await getCollection('work'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

const pageTitle = 'Ruth Lara Reyes | Estrategia de Comunicación y Sistemas de Contenido para Pymes';
const pageDescription = 'Convierte tu experiencia profesional en visibilidad online clara y sólida. Estrategia de comunicación, posicionamiento y formación en español, italiano e inglés.';
const bookingUrl = 'https://calendar.app.google/aC9rPWPAnMPtHYwV9';

const pageFaqs = [
  {
    question: '¿Por qué muchas empresas y profesionales con talento son invisibles online?',
    answer: 'La mayoría de las pymes y profesionales independientes dependen de una web desactualizada y publicaciones esporádicas en redes sociales sin un mensaje claro ni un sistema de contenidos replicable.'
  },
  {
    question: '¿Qué ocurre durante la sesión estratégica de 45 minutos?',
    answer: 'Revisamos tu presencia online actual, identificamos dónde tu mensaje pierde claridad o autoridad y trazamos los siguientes pasos prácticos.'
  },
  {
    question: '¿Trabajas solo con empresas en Florencia y Chianti o también a nivel internacional?',
    answer: 'Trabajo de forma local en la Toscana y de manera online con clientes internacionales en español, italiano e inglés.'
  },
  {
    question: '¿Puedes formar a nuestro equipo interno en lugar de gestionarlo todo por nosotros?',
    answer: 'Sí, imparto talleres y cursos a medida para equipos y profesionales para que puedan gestionar su sistema de contenidos de forma autónoma.'
  }
];
---

<BaseLayout lang="es" title={pageTitle} description={pageDescription} faqs={pageFaqs}>
  <div class="stack gap-20 lg:gap-48">
    <div class="wrapper stack gap-8 lg:gap-20">
      <header class="hero-grid">
        <Hero
          title="Eres Excelente en lo que Haces. Asegurémonos de que los Clientes te Encuentren."
          tagline="Ayudo a emprendedores, pymes y profesionales independientes a transformar mensajes poco claros en un sistema de comunicación estructurado."
          align="start"
        >
          <div class="roles-row">
            <Pill><Icon icon="strategy" size="1.33em" /> Estrategia de Comunicación</Pill>
            <Pill><Icon icon="microphone-stage" size="1.33em" /> Social Media Marketing</Pill>
            <Pill><Icon icon="pencil-line" size="1.33em" /> Formación</Pill>
          </div>

          <div class="hero-actions">
            <CallToAction href={bookingUrl}>
              Reserva una Sesión Estratégica de 45 Minutos
              <Icon icon="arrow-right" size="1.2em" />
            </CallToAction>
            <p>
              <a href="#how-i-work">Descubre cómo trabajo &darr;</a> &middot; Florencia, Italia y Todo el Mundo &middot; ES / IT / EN
            </p>
          </div>
        </Hero>

        <img
          alt="Ruth Lara Reyes — Estratega de Marketing y Comunicación"
          width="480"
          height="620"
          src="/assets/portrait.jpg"
        />
      </header>

      <aside class="media-bar" aria-label="Entrevistas y apariciones en medios">
        <span class="media-label">En los Medios</span>
        <div class="media-logos">
          <a href="https://forbes.com.ec" target="_blank" rel="noopener noreferrer" class="media-item">Forbes Ecuador</a>
          <a href="https://donnemente.it" target="_blank" rel="noopener noreferrer" class="media-item">DonneMente</a>
        </div>
      </aside>

      <div id="how-i-work">
        <Skills />
      </div>

      <section class="stack gap-4">
        <h2>Por Qué Trabajar Con Ruth</h2>
        <div class="proof-grid">
          <div class="proof-card">
            <h3>Rigor Académico, Enfoque Práctico</h3>
            <p>Respaldo de Doctorado y Maestría Summa Cum Laude con investigación real de audiencias.</p>
          </div>
          <div class="proof-card">
            <h3>Educadora y Docente Universitaria</h3>
            <p>Traducción de sistemas complejos de marketing en pasos claros para equipos.</p>
          </div>
          <div class="proof-card">
            <h3>Claridad Periodística</h3>
            <p>Comunicación con precisión, credibilidad e historias de alto impacto.</p>
          </div>
          <div class="proof-card">
            <h3>Tres Continentes, Tres Idiomas</h3>
            <p>Fluidez intercultural en español, italiano e inglés.</p>
          </div>
        </div>
      </section>
    </div>

    <main class="wrapper stack gap-20 lg:gap-48">
      <section class="stack gap-8">
        <header class="stack gap-2">
          <h3>Casos de Estudio y Proyectos Seleccionados</h3>
          <p>Cómo un posicionamiento claro convierte la experiencia en visibilidad medible.</p>
        </header>

        <Grid variant="offset">
          {projects.map((project) => (
            <li>
              <PortfolioPreview project={project} />
            </li>
          ))}
        </Grid>

        <div>
          <CallToAction href="/es/work/">
            Ver Todos los Casos de Estudio
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>

      <section class="stack gap-8" aria-labelledby="reviews-heading">
        <header class="stack gap-2">
          <h2 id="reviews-heading">Lo que Dicen Clientes y Líderes de Marketing</h2>
          <p>Testimonios de directivos internacionales y profesionales independientes.</p>
        </header>

        <div class="reviews-grid">
          <article class="review-card">
            <p class="review-quote">“A strategic thinker, a meticulous researcher, and an absolute pro at marketing and digital media…”</p>
            <div class="review-author">
              <strong>Felicia Knutson</strong>
              <span>Director of Creative &amp; Shared Services, Lippert</span>
            </div>
          </article>
          <article class="review-card">
            <p class="review-quote">“Working with Ruth was a real turning point for my personal brand and LinkedIn presence.”</p>
            <div class="review-author">
              <strong>Kathryn Clairand</strong>
              <span>Business HR English Coach · France</span>
            </div>
          </article>
          <article class="review-card">
            <p class="review-quote">“Ruth is a strong, strategic marketer who consistently delivers with purpose and professionalism.”</p>
            <div class="review-author">
              <strong>Hannah Corn</strong>
              <span>VP of Marketing</span>
            </div>
          </article>
        </div>
      </section>

      <section class="story-teaser">
        <h2>De la Investigación a la Estrategia Internacional</h2>
        <p>Trayectoria iniciada en el periodismo y consolidada con un Doctorado, una Maestría Summa Cum Laude y experiencia internacional en tres continentes. <a href="/es/about/">Lee mi historia completa &rarr;</a></p>
      </section>

      <section class="stack gap-4">
        <header class="stack gap-2">
          <h3>Preguntas Frecuentes</h3>
          <p>Respuestas claras sobre cómo transformamos tu sistema de comunicación.</p>
        </header>
        <div class="stack gap-4">
          {pageFaqs.map((faq) => (
            <div class="faq-card">
              <h4>{faq.question}</h4>
              <p>{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>
