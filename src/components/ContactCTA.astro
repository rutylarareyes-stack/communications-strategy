---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';

const bookingUrl = 'https://calendar.app.google/aC9rPWPAnMPtHYwV9';

const pathname = Astro.url.pathname;
const lang = pathname.startsWith('/it') ? 'it' : pathname.startsWith('/es') ? 'es' : 'en';

const copy = {
  en: {
    heading: 'Ready to Make Your Expertise Easy to Find?',
    cta: 'Book a 45-Minute Strategy Call',
  },
  it: {
    heading: 'Pronto a Rendere Visibile il Tuo Valore Online?',
    cta: 'Prenota una Sessione Strategica di 45 Minuti',
  },
  es: {
    heading: '¿Listo para Hacer Visible tu Experiencia Online?',
    cta: 'Reserva una Sesión Estratégica de 45 Minutos',
  },
} as const;

const content = copy[lang];
---

<aside>
  <h2>{content.heading}</h2>
  <CallToAction href={bookingUrl}>
    {content.cta}
    <Icon icon="paper-plane-tilt" size="1.2em" />
  </CallToAction>
</aside>

<style>
  aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    border-top: 1px solid var(--gray-800);
    border-bottom: 1px solid var(--gray-800);
    padding: 5rem 1.5rem;
    background-color: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
  }

  h2 {
    font-size: var(--text-xl);
    text-align: center;
    max-width: 22ch;
  }

  @media (min-width: 50em) {
    aside {
      padding: 7.5rem 5rem;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    h2 {
      font-size: var(--text-3xl);
      text-align: left;
    }
  }
</style>
