---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work', ({ id }) => !id.startsWith('it/') && !id.startsWith('es/')))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
	title="My Work | Ruth Lara Reyes"
	description="Explore Ruth Lara Reyes's recent strategic positioning, brand repositioning, local marketing, and training case studies."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="My Work"
				tagline="See my most recent projects below to get an idea of my past experience."
				align="start"
			/>
			<Grid variant="offset">
				{projects.map((project) => (
					<li>
						<PortfolioPreview project={project} />
					</li>
				))}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

