---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';
import Hero from '../../components/Hero.astro';
import Grid from '../../components/Grid.astro';

const projects = (await getCollection('work', ({ id }) => id.startsWith('it/')))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const pageTitle = 'Progetti e Casi Studio | Ruth Lara Reyes';
const pageDescription =
  'Scopri come strategia di comunicazione, posizionamento e sistemi editoriali aiutano imprese e professionisti a costruire visibilità online.';
---

<BaseLayout lang="it" title={pageTitle} description={pageDescription}>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="Progetti e Casi Studio"
        tagline="Esempi concreti di strategia di comunicazione, posizionamento e sistemi di contenuti progettati per generare chiarezza e risultati."
        align="start"
      />
      <Grid variant="offset">
        {
          projects.map((project) => (
            <li>
              <PortfolioPreview project={project} />
            </li>
          ))
        }
      </Grid>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>

