---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';

const projects = (await getCollection('work'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

const pageTitle = 'Ruth Lara Reyes | Communications Strategy & Content Systems for SMEs';
const pageDescription = 'Turn your offline expertise into clear online visibility. Marketing and communications strategy, content systems, and training in English, Italian, and Spanish.';

const bookingUrl = 'https://calendly.com'; // Replace with your booking link or mailto:your@email.com

const pageFaqs = [
  {
    question: 'Why are skilled businesses and professionals often invisible online?',
    answer: 'Most SMEs and independent professionals rely on an outdated website and sporadic social media posts without a clear message or repeatable content system. When your positioning is unclear, both potential clients and search engines struggle to understand what makes you the right choice.'
  },
  {
    question: 'What happens during the 45-minute strategy call?',
    answer: 'We review your current online presence, identify where your message is losing clarity or trust, and map out practical next steps across strategy, social media management, or team training.'
  },
  {
    question: 'Do you work only with companies in Florence and Chianti, or internationally?',
    answer: 'I am based in the Florence area in Italy and work both locally in Tuscany and online with international entrepreneurs, SMEs, and Spanish-speaking professionals worldwide in English, Italian, and Spanish.'
  },
  {
    question: 'Can you train our internal team instead of managing everything for us?',
    answer: 'Yes. Alongside strategy and ongoing social media management, I run tailored workshops and courses for business teams, professionals, and training institutions so your team can run a consistent content system independently.'
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} faqs={pageFaqs}>
  <div class="stack gap-20 lg:gap-48">
    <div class="wrapper stack gap-8 lg:gap-20">
      <!-- 1. FIRST SCREEN: Visitor Pain Point + Next Step + Short Credibility Line -->
      <header class="hero">
        <Hero
          title="You Are Great at What You Do. Let’s Make Sure Clients Can Find You."
          tagline="I help entrepreneurs, SMEs, and independent professionals turn unclear messaging and irregular posting into a structured communications system that builds trust and brings in clients."
          align="start"
        >
          <div class="roles">
            <Pill><Icon icon="strategy" size="1.33em" /> Communications Strategy</Pill>
            <Pill><Icon icon="microphone-stage" size="1.33em" /> Social Management</Pill>
            <Pill><Icon icon="pencil-line" size="1.33em" /> Team &amp; Institutional Training</Pill>
          </div>

          <div class="hero-actions">
            <CallToAction href={bookingUrl}>
              Book a 45-Minute Strategy Call
              <Icon icon="arrow-right" size="1.2em" />
            </CallToAction>
            <a href="#how-i-work" class="secondary-link">See how I work &darr;</a>
          </div>

          <p class="hero-trust-line">
            PhD &amp; Master’s Summa Cum Laude &middot; Florence, Italy &amp; Worldwide &middot; EN / IT / ES
          </p>
        </Hero>

        <img
          alt="Ruth Lara Reyes — Marketing and Communications Strategist"
          width="480"
          height="620"
          src="/assets/portrait.jpg"
        />
      </header>

      <!-- How I Work (3 Core Paths) -->
      <div id="how-i-work">
        <Skills />
      </div>

      <!-- 2. MIDDLE OF PAGE: "Why Ruth" Proof Points -->
      <section class="why-ruth">
        <header class="why-header">
          <h2>Why Work With Ruth</h2>
          <p>Academic rigor combined with practical execution for real-world businesses.</p>
        </header>

        <div class="proof-grid">
          <div class="proof-card">
            <h3>Academic Rigor, Practical Focus</h3>
            <p>Backed by a PhD and Master’s Summa Cum Laude, every messaging framework is built on structured audience research—not guesswork or fleeting trends.</p>
          </div>
          <div class="proof-card">
            <h3>Educator &amp; University Lecturer</h3>
            <p>Experience teaching at universities and training institutions means complex marketing systems are translated into clear steps your team can actually run.</p>
          </div>
          <div class="proof-card">
            <h3>Journalistic Clarity</h3>
            <p>A background in journalism ensures your brand communicates with precision, credibility, and stories that earn genuine attention.</p>
          </div>
          <div class="proof-card">
            <h3>Three Continents, Three Languages</h3>
            <p>Cross-cultural fluency in English, Italian, and Spanish helps local Tuscan businesses and international brands connect seamlessly across borders.</p>
          </div>
        </div>
      </section>
    </div>

    <main class="wrapper stack gap-20 lg:gap-48">
      <!-- Selected Work & Case Studies -->
      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Selected Work &amp; Case Studies</h3>
          <p>How clear positioning and structured content systems turn expertise into measurable visibility.</p>
        </header>

        <div class="gallery">
          <Grid variant="offset">
            {
              projects.map((project) => (
                <li>
                  <PortfolioPreview project={project} />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/work/">
            View All Case Studies
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>

      <!-- 3. LOWER ON PAGE: Story Teaser (80-100 words) -> Links to /about/ -->
      <section class="story-teaser">
        <div class="story-content">
          <h2>From Newsrooms to International Strategy</h2>
          <p>
            My career began in journalism, learning how to find the core truth of a story and communicate it clearly under pressure. Over the years, my work and academic research took me across three continents—culminating in a PhD, a Master’s Summa Cum Laude, and a move to Italy, where I rebuilt my career from the ground up. Today, from the Florence area, I bring that same investigative rigor and cross-cultural perspective to help entrepreneurs, SMEs, and institutions build communications systems that last.
          </p>
          <a href="/about/" class="story-link">Read my full story &rarr;</a>
        </div>
      </section>

      <!-- Frequently Asked Questions (AEO Schema) -->
      <section class="section with-background bg-variant">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Frequently Asked Questions</h3>
          <p>Clear answers about how we turn your expertise into a working communications system.</p>
        </header>

        <div class="faq-list stack gap-4">
          {
            pageFaqs.map((faq) => (
              <details class="faq-item" open>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .roles {
    display: none;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .secondary-link {
    color: var(--gray-200);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--gray-500);
    padding-bottom: 0.15rem;
    transition: color var(--theme-transition), border-color var(--theme-transition);
  }

  .secondary-link:hover {
    color: var(--accent-regular);
    border-color: var(--accent-regular);
  }

  .hero-trust-line {
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: var(--gray-400);
    letter-spacing: 0.01em;
  }

  .hero img {
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: top;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  /* Why Ruth Proof Grid */
  .why-ruth {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .why-header {
    text-align: center;
    max-width: 50ch;
    margin: 0 auto;
  }

  .why-header h2 {
    font-size: var(--text-2xl);
    color: var(--gray-0);
    margin-bottom: 0.5rem;
  }

  .why-header p {
    color: var(--gray-300);
    font-size: var(--text-md);
  }

  .proof-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 50em) {
    .proof-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
    .why-header h2 {
      font-size: var(--text-4xl);
    }
  }

  .proof-card {
    background: var(--gray-999_40);
    border: 1px solid var(--gray-800);
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .proof-card h3 {
    font-size: var(--text-lg);
    color: var(--gray-0);
    margin-bottom: 0.5rem;
  }

  .proof-card p {
    color: var(--gray-300);
    line-height: 1.6;
  }

