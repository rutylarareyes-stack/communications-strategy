---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';
import Hero from '../../components/Hero.astro';
import Grid from '../../components/Grid.astro';

const projects = (await getCollection('work', ({ id }) => id.startsWith('es/')))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const pageTitle = 'Proyectos y Casos de Estudio | Ruth Lara Reyes';
const pageDescription =
  'Explora casos de estudio de estrategia de comunicación, posicionamiento y sistemas de contenido para pymes y profesionales.';
---

<BaseLayout lang="es" title={pageTitle} description={pageDescription}>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="Proyectos y Casos de Estudio"
        tagline="Ejemplos reales de estrategia de comunicación, posicionamiento y sistemas de contenido diseñados para generar claridad y resultados."
        align="start"
      />
      <Grid variant="offset">
        {
          projects.map((project) => (
            <li>
              <PortfolioPreview project={project} />
            </li>
          ))
        }
      </Grid>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>

