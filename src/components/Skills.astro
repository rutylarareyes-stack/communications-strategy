---
import Icon from './Icon.astro';
---

<section class="box skills-wrapper" aria-labelledby="work-together-heading">
  <header class="skills-header">
    <h2 id="work-together-heading">How We Can Work Together</h2>
    <p>Choose the level of strategic support and execution that fits your business right now.</p>
  </header>

  <div class="skills">
    <div class="stack gap-2 lg:gap-4">
      <Icon icon="strategy" color="var(--accent-regular)" size="2.5rem" gradient />
      <h3>Done For You</h3>
      <p>I take care of the strategy and execution, so you can focus on running your business.</p>
    </div>

    <div class="stack gap-2 lg:gap-4">
      <Icon icon="handshake" color="var(--accent-regular)" size="2.5rem" gradient />
      <h3>Done With You</h3>
      <p>We work together to clarify your direction, make informed decisions, and put your strategy into action.</p>
    </div>

    <div class="stack gap-2 lg:gap-4">
      <Icon icon="pencil-line" color="var(--accent-regular)" size="2.5rem" gradient />
      <h3>Learn How</h3>
      <p>I equip you with the knowledge, tools, and confidence to manage your communication independently.</p>
    </div>
  </div>
</section>

<style>
  .box {
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    padding: 1.75rem 1.5rem;
    background-color: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
  }

  .skills-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .skills-header {
    text-align: center;
    max-width: 52ch;
    margin: 0 auto;
  }

  .skills-header h2 {
    font-size: var(--text-xl);
    color: var(--gray-0);
    margin-bottom: 0.5rem;
  }

  .skills-header p {
    color: var(--gray-300);
    font-size: var(--text-md);
  }

  .skills {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .skills h3 {
    font-size: var(--text-lg);
    color: var(--gray-0);
  }

  .skills p {
    color: var(--gray-300);
    line-height: 1.6;
  }

  @media (min-width: 50em) {
    .box {
      border-radius: 1.5rem;
      padding: 3rem 2.5rem;
    }

    .skills-header h2 {
      font-size: var(--text-3xl);
    }

    .skills {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4rem;
    }

    .skills h3 {
      font-size: var(--text-2xl);
    }
  }
</style>
